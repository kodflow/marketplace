{
  "description": "Exemple de configuration de hooks pour un plugin Kodflow",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/example-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
