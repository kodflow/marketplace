{
  "description": "Go plugin — reformatage automatique des fichiers Go apres ecriture",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/format-go.sh\"",
            "timeout": 10,
            "statusMessage": "Formatage du fichier Go..."
          }
        ]
      }
    ]
  }
}
